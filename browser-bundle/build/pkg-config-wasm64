#!/bin/sh
# Cross pkg-config wrapper for QEMU wasm64 build targeting the Emscripten dependency prefix
TARGET_PREFIX="${TARGET_DIR:-/Users/Shared/toolchain/t157-v5-deps/target}"
PKG_CONFIG_PATH="${TARGET_PREFIX}/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export PKG_CONFIG_PATH
PKG_CONFIG_BIN="$(command -v pkg-config || echo /opt/homebrew/bin/pkg-config)"
exec "$PKG_CONFIG_BIN" "$@"
