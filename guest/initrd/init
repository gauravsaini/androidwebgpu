#!/bin/sh
# Minimal PID 1 Init Script for AndroidWebGPU v86 Guest Environment
# Initializes BinderFS, ServiceManager, Native Rust Services, Virtual HALs
# + synthetic virtio-gpu probe (Option A) — runs if binary present

export PATH=/system/bin:/system/xbin:/sbin:/bin:/usr/bin
export LD_LIBRARY_PATH=/system/lib:/system/lib64:/vendor/lib
export ANDROID_ROOT=/system
export ANDROID_DATA=/data
export BOOTCLASSPATH=/system/framework/core-libart.jar:/system/framework/ext.jar:/system/framework/framework.jar:/system/framework/services.jar

# 1. Mount virtual file systems
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true
mount -t tmpfs tmpfs /data 2>/dev/null || true
mkdir -p /dev/pts /dev/socket /dev/binderfs /data/app /data/system 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true

# 2. Mount BinderFS and create Binder device nodes
mount -t binder binder /dev/binderfs 2>/dev/null || true
ln -sf /dev/binderfs/binder /dev/binder 2>/dev/null || true
ln -sf /dev/binderfs/hwbinder /dev/hwbinder 2>/dev/null || true
ln -sf /dev/binderfs/vndbinder /dev/vndbinder 2>/dev/null || true
chmod 0666 /dev/binder /dev/binderfs/binder /dev/binderfs/hwbinder /dev/binderfs/vndbinder 2>/dev/null || true

# 2b. Load VirtIO and DRM Kernel Modules
KVER=$(uname -r 2>/dev/null || echo "6.6.142-0-lts")
MODDIR="/lib/modules/$KVER"
if [ ! -d "$MODDIR" ]; then
    MODDIR="/lib/modules/6.6.142-0-lts"
fi

echo "[init] Loading DRM and VirtIO kernel modules from $MODDIR..." > /dev/ttyS0 2>/dev/null || true

for mpath in \
    "$MODDIR/kernel/drivers/virtio/virtio.ko" \
    "$MODDIR/kernel/drivers/virtio/virtio_ring.ko" \
    "$MODDIR/kernel/drivers/virtio/virtio_pci_modern_dev.ko" \
    "$MODDIR/kernel/drivers/virtio/virtio_pci.ko" \
    "$MODDIR/kernel/drivers/i2c/i2c-core.ko" \
    "$MODDIR/kernel/drivers/gpu/drm/drm_panel_orientation_quirks.ko" \
    "$MODDIR/kernel/drivers/gpu/drm/drm.ko" \
    "$MODDIR/kernel/drivers/gpu/drm/drm_kms_helper.ko" \
    "$MODDIR/kernel/drivers/gpu/drm/drm_shmem_helper.ko" \
    "$MODDIR/kernel/drivers/virtio/virtio_dma_buf.ko" \
    "$MODDIR/kernel/drivers/gpu/drm/virtio/virtio-gpu.ko"; do
    if [ -f "$mpath" ]; then
        insmod "$mpath" 2>/dev/null && echo "[init] Loaded $(basename "$mpath")" > /dev/ttyS0 2>/dev/null || true
    fi
done
depmod -a 2>/dev/null || true
modprobe virtio-gpu 2>/dev/null || modprobe virtio_gpu 2>/dev/null || true

# 2c. Stage F-Droid APK into /data/app/org.fdroid.fdroid/base.apk
mkdir -p /data/app/org.fdroid.fdroid 2>/dev/null || true
if [ -f /system/app/org.fdroid.fdroid/base.apk ]; then
    cp /system/app/org.fdroid.fdroid/base.apk /data/app/org.fdroid.fdroid/base.apk 2>/dev/null || true
    echo "[init] staged F-Droid APK at /data/app/org.fdroid.fdroid/base.apk" > /dev/ttyS0 2>/dev/null || true
fi

while [ ! -e /dev/binder ]; do
    sleep 0.05 2>/dev/null || sleep 1
    break
done

echo "[init] Linux version 5.10.0-android-x86 (androidwebgpu@v86)" > /dev/ttyS0 2>/dev/null || echo "[init] Linux version 5.10.0-android-x86 (androidwebgpu@v86)"
echo "[init] binderfs mounted successfully at /dev/binderfs" > /dev/ttyS0 2>/dev/null || true

# 3. Start ServiceManager (Context Manager - Root Handle 0)
if [ -x /system/bin/servicemanager ]; then
    /system/bin/servicemanager &
    if [ -x /system/bin/service_check ]; then
        i=0; while ! /system/bin/service_check 0 2>/dev/null; do sleep 0.05 2>/dev/null || sleep 0.1; i=$((i+1)); [ $i -gt 20 ] && break; done
    else
        sleep 0.1
    fi
    echo "[init] servicemanager started (handle 0 context manager)" > /dev/ttyS0 2>/dev/null || true
    echo "[init] servicemanager pid $! handle 0" > /dev/ttyS0 2>/dev/null || true
else
    echo "[init] servicemanager binary standby" > /dev/ttyS0 2>/dev/null || true
fi

# 3a. Check DRM device presence from kernel driver
mkdir -p /dev/dri 2>/dev/null || true
chmod 0666 /dev/dri/* /dev/fb* /dev/graphics/* 2>/dev/null || true
if [ -d /sys/class/drm ]; then
    echo "[init] /sys/class/drm contents:" > /dev/ttyS0 2>/dev/null || true
    ls -la /sys/class/drm/ > /dev/ttyS0 2>&1 || true
fi
if [ -d /dev/dri ]; then
    echo "[init] /dev/dri contents:" > /dev/ttyS0 2>/dev/null || true
    ls -la /dev/dri/ > /dev/ttyS0 2>&1 || true
fi
sleep 0.1 2>/dev/null || true

# 3b. Start SurfaceFlinger (Linked against egl_webgpu.so, gralloc.virtgpu.so, hwcomposer.virtgpu.so)
if [ -x /system/bin/surfaceflinger ]; then
    /system/bin/surfaceflinger > /dev/ttyS0 2>&1 &
    echo "[init] surfaceflinger started (DRM /dev/dri linkage)" > /dev/ttyS0 2>/dev/null || true
fi

# 4. Start Native Rust System Services
if [ -x /system/bin/pms_rs ]; then /system/bin/pms_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi
if [ -x /system/bin/ams_rs ]; then /system/bin/ams_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi
if [ -x /system/bin/wms_rs ]; then /system/bin/wms_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi
if [ -x /system/bin/inputflinger_rs ]; then /system/bin/inputflinger_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi

# 5. Start Virtual AIDL HAL Daemons
if [ -x /system/bin/sensors_hal_virtual ]; then /system/bin/sensors_hal_virtual > /dev/ttyS0 2>&1 & fi
if [ -x /system/bin/audio_hal_virtual ]; then /system/bin/audio_hal_virtual > /dev/ttyS0 2>&1 & fi
if [ -x /system/bin/camera_hal_virtual ]; then /system/bin/camera_hal_virtual > /dev/ttyS0 2>&1 & fi

# 5b. Start Zygote Daemon (boot.art, framework.jar, /dev/socket/zygote)
if [ -x /system/bin/app_process ]; then
    /system/bin/app_process > /dev/ttyS0 2>&1 &
    echo "[init] zygote app_process started" > /dev/ttyS0 2>/dev/null || true
elif [ -x /system/bin/zygote ]; then
    /system/bin/zygote > /dev/ttyS0 2>&1 &
    echo "[init] zygote daemon started" > /dev/ttyS0 2>/dev/null || true
fi

echo "[init] native Rust services and virtual HALs started" > /dev/ttyS0 2>/dev/null || true

# 5c. Phase 4 Graphics and 2D Skia Rasterization tests
if [ -x /system/bin/skia_fb_test ]; then
    echo "[init] running skia_fb_test (Phase 4b 2D rasterization)..." > /dev/ttyS0 2>/dev/null || true
    /system/bin/skia_fb_test > /dev/ttyS0 2>&1 || true
fi

if [ -x /system/bin/test_triangle ]; then
    echo "[init] running test_triangle (Phase 4a GPU triangle)..." > /dev/ttyS0 2>/dev/null || true
    /system/bin/test_triangle > /dev/ttyS0 2>&1 || true
fi

echo "[init] system boot completed successfully" > /dev/ttyS0 2>/dev/null || true

# 6. Interactive console - keep PID 1 alive even if /bin/sh missing (TinyCore/Alpine fix)
# Original exec /bin/sh fails because initrd has no /bin/sh -> PID 1 exits -> panic "kill idle task"
if [ -x /bin/sh ]; then
    exec /bin/sh < /dev/ttyS0 > /dev/ttyS0 2>&1
elif [ -x /system/bin/sh ]; then
    exec /system/bin/sh < /dev/ttyS0 > /dev/ttyS0 2>&1
elif [ -c /dev/ttyS0 ]; then
    echo "[init] no shell found, entering idle loop (PID 1 keepalive) to avoid panic" > /dev/ttyS0 2>/dev/null || true
    while true; do sleep 3600 2>/dev/null || sleep 60; done
else
    while true; do sleep 3600 2>/dev/null || sleep 60; done
fi
