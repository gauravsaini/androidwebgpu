#!/bin/sh
# Minimal PID 1 Init Script for AndroidWebGPU v86 Guest Environment
# Initializes BinderFS, ServiceManager, Native Rust Services, Virtual HALs
# + synthetic virtio-gpu probe (Option A) — runs if binary present

export PATH=/system/bin:/system/xbin:/sbin:/bin:/usr/bin
export LD_LIBRARY_PATH=/system/lib:/system/lib64:/vendor/lib
export ANDROID_ROOT=/system
export ANDROID_DATA=/data
export BOOTCLASSPATH=/system/framework/core-libart.jar:/system/framework/ext.jar:/system/framework/framework.jar:/system/framework/services.jar

# 1. Mount virtual file systems
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs tmpfs /tmp 2>/dev/null || true
mount -t tmpfs tmpfs /data 2>/dev/null || true
mkdir -p /dev/pts /dev/socket /dev/binderfs /data/app /data/system 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true

# 2. Mount BinderFS and create Binder device nodes
mount -t binder binder /dev/binderfs 2>/dev/null || true
ln -sf /dev/binderfs/binder /dev/binder 2>/dev/null || true
ln -sf /dev/binderfs/hwbinder /dev/hwbinder 2>/dev/null || true
ln -sf /dev/binderfs/vndbinder /dev/vndbinder 2>/dev/null || true
chmod 0666 /dev/binder /dev/binderfs/binder /dev/binderfs/hwbinder /dev/binderfs/vndbinder 2>/dev/null || true

# 2b. Load VirtIO and DRM Kernel Modules
KVER=$(uname -r 2>/dev/null || echo "6.6.142-0-lts")
MODDIR="/lib/modules/$KVER"
if [ ! -d "$MODDIR" ]; then
    MODDIR="/lib/modules/6.6.142-0-lts"
fi

echo "[init] Loading DRM and VirtIO kernel modules from $MODDIR..." > /dev/ttyS0 2>/dev/null || true

echo "[init] Probing VirtIO-GPU PCI device before module load..." > /dev/ttyS0 2>/dev/null || true
# Show PCI devices (should include 1AF4:1050 virtio-gpu at slot 0x06 if host registered correctly)
cat /proc/bus/pci/devices 2>/dev/null | head -n 20 > /dev/ttyS0 2>&1 || true
lspci 2>/dev/null | head -n 20 > /dev/ttyS0 2>&1 || true
# Also check via /sys/bus/pci/devices if available
ls -la /sys/bus/pci/devices/ 2>/dev/ttyS0 2>&1 || true

# Direct insmod with explicit paths - VERBOSE FIX 2026-08-29 v2 (explicit absolute, no $MODBASE variable - sh.c has no expansion) - topo order
# modules.dep: drm.ko -> panel_quirks + i2c-core; virtio_pci -> modern+legacy+ring+virtio; virtio-gpu -> dma_buf+shmem+kms+drm
echo "[init][VERBOSE] Loading Virtio-GPU stack via explicit insmod 12 steps topo sorted ..." > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][1/12] insmod i2c-core.ko ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/i2c/i2c-core.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][1/12] i2c-core.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][1/12] i2c-core.ko : FAIL required for drm.ko" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][2/12] insmod drm_panel_orientation_quirks.ko ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/gpu/drm/drm_panel_orientation_quirks.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][2/12] drm_panel_orientation_quirks.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][2/12] drm_panel_orientation_quirks.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][3/12] insmod virtio.ko ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/virtio/virtio.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][3/12] virtio.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][3/12] virtio.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][4/12] insmod virtio_ring.ko ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/virtio/virtio_ring.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][4/12] virtio_ring.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][4/12] virtio_ring.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][5/12] insmod virtio_pci_modern_dev.ko must be before virtio_pci ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/virtio/virtio_pci_modern_dev.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][5/12] virtio_pci_modern_dev.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][5/12] virtio_pci_modern_dev.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][6/12] insmod virtio_pci_legacy_dev.ko ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/virtio/virtio_pci_legacy_dev.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][6/12] virtio_pci_legacy_dev.ko : OK optional" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][6/12] virtio_pci_legacy_dev.ko : optional miss" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][7/12] insmod virtio_pci.ko depends on 3 4 5 6 ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/virtio/virtio_pci.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][7/12] virtio_pci.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][7/12] virtio_pci.ko : FAIL check dmesg unknown symbol" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][8/12] insmod virtio_dma_buf.ko ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/virtio/virtio_dma_buf.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][8/12] virtio_dma_buf.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][8/12] virtio_dma_buf.ko : optional" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][9/12] insmod drm.ko depends on 1 2 ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/gpu/drm/drm.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][9/12] drm.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][9/12] drm.ko : FAIL missing i2c panel_quirks" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][10/12] insmod drm_shmem_helper.ko depends on 9 ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/gpu/drm/drm_shmem_helper.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][10/12] drm_shmem_helper.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][10/12] drm_shmem_helper.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][11/12] insmod drm_kms_helper.ko depends on 9 ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/gpu/drm/drm_kms_helper.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][11/12] drm_kms_helper.ko : OK" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][11/12] drm_kms_helper.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE][12/12] insmod virtio-gpu.ko depends on 3 4 8 9 10 11 ..." > /dev/ttyS0 2>/dev/null || true
insmod /lib/modules/6.6.142-0-lts/kernel/drivers/gpu/drm/virtio/virtio-gpu.ko 2>/dev/ttyS0 && echo "[init][VERBOSE][12/12] virtio-gpu.ko : OK GUEST DRM READY" > /dev/ttyS0 2>/dev/null || echo "[init][VERBOSE][12/12] virtio-gpu.ko : FAIL" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE] Virtio stack insmod sequence done checking lsmod and dmesg" > /dev/ttyS0 2>/dev/null || true
lsmod 2>/dev/ttyS0 | head -n 40 > /dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] lsmod filtered virtio drm i2c" > /dev/ttyS0 2>/dev/null || true
lsmod 2>/dev/ttyS0 | grep -E "virtio|drm|i2c" > /dev/ttyS0 2>&1 || true
dmesg 2>/dev/ttyS0 | tail -n 50 > /dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] dmesg filtered virtio drm" > /dev/ttyS0 2>/dev/null || true
dmesg 2>/dev/ttyS0 | grep -i -E "virtio|drm" 2>&1 | tail -n 30 > /dev/ttyS0 2>&1 || true
sleep 0.3 2>/dev/null || true
echo "[init][VERBOSE] DRM probe after module load" > /dev/ttyS0 2>/dev/null || true
echo "[init][VERBOSE] Enable dynamic debug for virtio drivers ..." > /dev/ttyS0 2>/dev/null || true
echo 'file drivers/virtio/* +p' > /sys/kernel/debug/dynamic_debug/control 2>/dev/null || true
echo "[init][VERBOSE] Trigger PCI rescan for hot-plug virtio-gpu (host registers at 108ms, kernel scanned earlier) ..." > /dev/ttyS0 2>/dev/null || true
echo 1 > /sys/bus/pci/rescan 2>/dev/ttyS0 || echo 1 > /sys/bus/pci/rescan 2>&1 > /dev/ttyS0 || true
sleep 0.2 2>/dev/null || true
echo "[init][VERBOSE] Fallback manual new_id and bind for virtio-pci ..." > /dev/ttyS0 2>/dev/null || true
echo "1af4 1050" > /sys/bus/pci/drivers/virtio-pci/new_id 2>/dev/null || true
echo "0000:00:06.0" > /sys/bus/pci/drivers/virtio-pci/bind 2>/dev/null || true
dmesg 2>/dev/ttyS0 | tail -n 20 > /dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] Post-rescan PCI and DRM check ..." > /dev/ttyS0 2>/dev/null || true
cat /proc/bus/pci/devices 2>/dev/ttyS0 2>&1 | head -n 20 || true
ls -la /sys/bus/pci/devices/ 2>/dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] DIAG after rescan: /proc/ioports (should show 0xc000 vs 0xc140)" > /dev/ttyS0 2>/dev/null || true
cat /proc/ioports 2>/dev/ttyS0 2>&1 | head -n 30 || true
echo "[init][VERBOSE] DIAG resource for 00:06.0 (BAR0 should be c001 or c141)" > /dev/ttyS0 2>/dev/null || true
cat /sys/bus/pci/devices/0000:00:06.0/resource 2>/dev/ttyS0 2>&1 || true
cat /sys/bus/pci/devices/0000:00:06.0/modalias 2>/dev/ttyS0 2>&1 || true
cat /proc/interrupts 2>/dev/ttyS0 2>&1 | grep 10 || true
ls -la /sys/bus/pci/devices/0000:00:06.0/ 2>/dev/ttyS0 2>&1 | head -n 30 || true
ls -la /sys/class/drm/ 2>/dev/ttyS0 2>&1 || true
ls -la /dev/dri/ 2>/dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] Post-rescan dmesg tail virtio drm" > /dev/ttyS0 2>/dev/null || true
dmesg 2>/dev/ttyS0 | grep -i -E "virtio|drm" | tail -n 20 2>&1 > /dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] Check virtio bus devices" > /dev/ttyS0 2>/dev/null || true
ls -la /sys/bus/virtio/devices/ 2>/dev/ttyS0 2>&1 || true
ls -la /sys/bus/virtio/drivers/ 2>/dev/ttyS0 2>&1 || true
ls -la /sys/bus/pci/drivers/virtio-pci/ 2>/dev/ttyS0 2>&1 || true
echo "[init][VERBOSE] ls /sys/bus/pci/devices/0000:00:06.0/driver" > /dev/ttyS0 2>/dev/null || true
ls -la /sys/bus/pci/devices/0000:00:06.0/driver 2>/dev/ttyS0 2>&1 || readlink /sys/bus/pci/devices/0000:00:06.0/driver 2>/dev/ttyS0 2>&1 || true

# 2c. Stage F-Droid APK into /data/app/org.fdroid.fdroid/base.apk
mkdir -p /data/app/org.fdroid.fdroid 2>/dev/null || true
if [ -f /system/app/org.fdroid.fdroid/base.apk ]; then
    cp /system/app/org.fdroid.fdroid/base.apk /data/app/org.fdroid.fdroid/base.apk 2>/dev/null || true
    echo "[init] staged F-Droid APK at /data/app/org.fdroid.fdroid/base.apk" > /dev/ttyS0 2>/dev/null || true
fi

while [ ! -e /dev/binder ]; do
    sleep 0.05 2>/dev/null || sleep 1
    break
done

echo "[init] Linux version 5.10.0-android-x86 (androidwebgpu@v86)" > /dev/ttyS0 2>/dev/null || echo "[init] Linux version 5.10.0-android-x86 (androidwebgpu@v86)"
echo "[init] binderfs mounted successfully at /dev/binderfs" > /dev/ttyS0 2>/dev/null || true

# 3. Start ServiceManager (Context Manager - Root Handle 0)
if [ -x /system/bin/servicemanager ]; then
    /system/bin/servicemanager &
    if [ -x /system/bin/service_check ]; then
        i=0; while ! /system/bin/service_check 0 2>/dev/null; do sleep 0.05 2>/dev/null || sleep 0.1; i=$((i+1)); [ $i -gt 20 ] && break; done
    else
        sleep 0.1
    fi
    echo "[init] servicemanager started (handle 0 context manager)" > /dev/ttyS0 2>/dev/null || true
    echo "[init] servicemanager pid $! handle 0" > /dev/ttyS0 2>/dev/null || true
else
    echo "[init] servicemanager binary standby" > /dev/ttyS0 2>/dev/null || true
fi

# 3a. Check DRM device presence from kernel driver (verbose for guestActive debugging)
mkdir -p /dev/dri 2>/dev/null || true
chmod 0666 /dev/dri/* /dev/fb* /dev/graphics/* 2>/dev/null || true
echo "[init] DRM device probe: /sys/class/drm exists=$([ -d /sys/class/drm ] && echo yes || echo no) /dev/dri exists=$([ -d /dev/dri ] && echo yes || echo no)" > /dev/ttyS0 2>/dev/null || true
if [ -d /sys/class/drm ]; then
    echo "[init] /sys/class/drm contents:" > /dev/ttyS0 2>/dev/null || true
    ls -la /sys/class/drm/ > /dev/ttyS0 2>&1 || true
    if [ -z "$(ls -A /sys/class/drm 2>/dev/null)" ]; then
        echo "[init] WARNING: /sys/class/drm EMPTY -> virtio-gpu driver not bound (PCI slot collision? check host pciSlot=0x06 vs NE2000 0x05)" > /dev/ttyS0 2>/dev/null || true
        echo "[init] PCI devices:" > /dev/ttyS0 2>/dev/null || true
        cat /proc/bus/pci/devices 2>/dev/ttyS0 2>&1 | head -n 20 || true
    else
        echo "[init] DRM driver bound, devices present (good for surfaceflinger)" > /dev/ttyS0 2>/dev/null || true
    fi
else
    echo "[init] WARNING: /sys/class/drm missing entirely -> DRM subsystem not loaded" > /dev/ttyS0 2>/dev/null || true
fi
if [ -d /dev/dri ]; then
    echo "[init] /dev/dri contents:" > /dev/ttyS0 2>/dev/null || true
    ls -la /dev/dri/ > /dev/ttyS0 2>&1 || true
    if [ ! -e /dev/dri/card0 ]; then
        echo "[init] WARNING: /dev/dri/card0 missing -> surfaceflinger will get ENODEV (errno 19)" > /dev/ttyS0 2>/dev/null || true
    fi
fi
sleep 0.2 2>/dev/null || true
echo "[init] Starting surfaceflinger in 0.3s (wait for DRM to settle)..." > /dev/ttyS0 2>/dev/null || true
sleep 0.3 2>/dev/null || true

# 3b. Start SurfaceFlinger (Linked against egl_webgpu.so, gralloc.virtgpu.so, hwcomposer.virtgpu.so)
if [ -x /system/bin/surfaceflinger ]; then
    /system/bin/surfaceflinger > /dev/ttyS0 2>&1 &
    echo "[init] surfaceflinger started (DRM /dev/dri linkage)" > /dev/ttyS0 2>/dev/null || true
fi

# 4. Start Native Rust System Services
if [ -x /system/bin/pms_rs ]; then /system/bin/pms_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi
if [ -x /system/bin/ams_rs ]; then /system/bin/ams_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi
if [ -x /system/bin/wms_rs ]; then /system/bin/wms_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi
if [ -x /system/bin/inputflinger_rs ]; then /system/bin/inputflinger_rs > /dev/ttyS0 2>&1 & sleep 0.05 2>/dev/null || true; fi

# 5. Start Virtual AIDL HAL Daemons
if [ -x /system/bin/sensors_hal_virtual ]; then /system/bin/sensors_hal_virtual > /dev/ttyS0 2>&1 & fi
if [ -x /system/bin/audio_hal_virtual ]; then /system/bin/audio_hal_virtual > /dev/ttyS0 2>&1 & fi
if [ -x /system/bin/camera_hal_virtual ]; then /system/bin/camera_hal_virtual > /dev/ttyS0 2>&1 & fi

# 5b. Start Zygote Daemon (boot.art, framework.jar, /dev/socket/zygote)
if [ -x /system/bin/app_process ]; then
    /system/bin/app_process > /dev/ttyS0 2>&1 &
    echo "[init] zygote app_process started" > /dev/ttyS0 2>/dev/null || true
elif [ -x /system/bin/zygote ]; then
    /system/bin/zygote > /dev/ttyS0 2>&1 &
    echo "[init] zygote daemon started" > /dev/ttyS0 2>/dev/null || true
fi

echo "[init] native Rust services and virtual HALs started" > /dev/ttyS0 2>/dev/null || true

# 5c. Phase 4 Graphics and 2D Skia Rasterization tests
if [ -x /system/bin/skia_fb_test ]; then
    echo "[init] running skia_fb_test (Phase 4b 2D rasterization)..." > /dev/ttyS0 2>/dev/null || true
    /system/bin/skia_fb_test > /dev/ttyS0 2>&1 || true
fi

if [ -x /system/bin/test_triangle ]; then
    echo "[init] running test_triangle (Phase 4a GPU triangle)..." > /dev/ttyS0 2>/dev/null || true
    /system/bin/test_triangle > /dev/ttyS0 2>&1 || true
fi

echo "[init] system boot completed successfully" > /dev/ttyS0 2>/dev/null || true

# 6. Interactive console - keep PID 1 alive even if /bin/sh missing (TinyCore/Alpine fix)
# Original exec /bin/sh fails because initrd has no /bin/sh -> PID 1 exits -> panic "kill idle task"
if [ -x /bin/sh ]; then
    exec /bin/sh < /dev/ttyS0 > /dev/ttyS0 2>&1
elif [ -x /system/bin/sh ]; then
    exec /system/bin/sh < /dev/ttyS0 > /dev/ttyS0 2>&1
elif [ -c /dev/ttyS0 ]; then
    echo "[init] no shell found, entering idle loop (PID 1 keepalive) to avoid panic" > /dev/ttyS0 2>/dev/null || true
    while true; do sleep 3600 2>/dev/null || sleep 60; done
else
    while true; do sleep 3600 2>/dev/null || sleep 60; done
fi
